# Copy this file to .env and replace the placeholder values.
DJANGO_SECRET_KEY=replace-with-a-new-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Set this in Render or another hosted PostgreSQL provider. When unset, the
# local MySQL settings below are used.
# DATABASE_URL=postgresql://user:password@host:5432/database

DB_NAME=ecommerce_db
DB_USER=root
DB_PASSWORD=replace-with-your-local-database-password
DB_HOST=localhost
DB_PORT=3306

MERCADOPAGO_ACCESS_TOKEN=replace-with-your-mercado-pago-test-access-token
MERCADOPAGO_WEBHOOK_SECRET=replace-with-your-mercado-pago-webhook-secret
MERCADOPAGO_WEBHOOK_URL=https://your-public-domain/api/orders/payments/webhook/
FRONTEND_URL=http://localhost:5173

# Required by `python manage.py ensure_admin` during a Render deployment.
DJANGO_ADMIN_EMAIL=admin@example.com
DJANGO_ADMIN_PASSWORD=replace-with-a-long-unique-password
DJANGO_ADMIN_USERNAME=admin
